[Unattend]
Signature = "$LibreNT$"

; Unattended 2nd stage setup for pre-installed disk image
; First boot runs InstallLibreNT() automatically
UnattendSetupEnabled = no

; Install to \Device\Harddisk0\Partition1\Windows
DestinationDiskNumber = 0
DestinationPartitionNumber = 1
InstallationDirectory=Windows

FullName="LibreNT User"
ComputerName="LIBRENT"

; TimeZone is set GMT as default
TimeZoneIndex=85

; set this option to automatically
; specify language in 2nd mode setup
; see hivesys.inf for available languages
LocaleID = 409

; set product option
; 0: LibreNT Server
; 1: LibreNT Workstation
ProductOption = 1

; disable Gecko install for faster setup
DisableGeckoInst = yes

