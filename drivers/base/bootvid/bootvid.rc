#define LIBRENT_VERSION_DLL

/* Each bootvid configuration file defines LIBRENT_STR_FILE_DESCRIPTION */
#cmakedefine LIBRENT_STR_FILE_DESCRIPTION    "${LIBRENT_STR_FILE_DESCRIPTION}"
#ifndef LIBRENT_STR_FILE_DESCRIPTION
#define LIBRENT_STR_FILE_DESCRIPTION    "Boot Video Driver"
#endif

/* The main bootvid CMake file defines default values for
 * LIBRENT_STR_INTERNAL_NAME and LIBRENT_STR_ORIGINAL_FILENAME.
 * Each bootvid configuration file can override these values. */
#cmakedefine LIBRENT_STR_INTERNAL_NAME       "${LIBRENT_STR_INTERNAL_NAME}"
#ifndef LIBRENT_STR_INTERNAL_NAME
#define LIBRENT_STR_INTERNAL_NAME       "bootvid"
#endif

#cmakedefine LIBRENT_STR_ORIGINAL_FILENAME   "${LIBRENT_STR_ORIGINAL_FILENAME}"
#ifndef LIBRENT_STR_ORIGINAL_FILENAME
#define LIBRENT_STR_ORIGINAL_FILENAME   "bootvid.dll"
#endif

#include <librent/version.rc>
