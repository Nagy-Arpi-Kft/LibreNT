/*
 * Inspired by Wine file include/wine_common_ver.rc
 * Copyright 2001 Dmitry Timoshkov
 *
 * Most version components are set to reasonable defaults here.
 * If you're including this for a .DLL, #define LIBRENT_VERSION_DLL before the #include.
 * Other things to #define:
 * LIBRENT_STR_FILE_DESCRIPTION
 * LIBRENT_STR_INTERNAL_NAME
 * LIBRENT_STR_ORIGINAL_FILENAME
 *
 */

#include "winver.h"
#include "version.h"
#include "buildno.h"
#include <ntverp.h>

/* Define some defaults (shouldn't be overwritten by applications) */
#define LIBRENT_DEFAULT_STR_COMPANY_NAME    "LibreNT Project"
#define LIBRENT_DEFAULT_STR_DESCRIPTION     "LibreNT Core Component"
#define LIBRENT_DEFAULT_STR_INTERNAL_NAME   ""
#define LIBRENT_DEFAULT_STR_LEGAL_COPYRIGHT "(C) 1996-" COPYRIGHT_YEAR " ReactOS and LibreNT contributors"
#define LIBRENT_DEFAULT_STR_PRODUCT_NAME    "LibreNT Operating System"

/* Set defaults for everything, unless overridden */
#ifndef LIBRENT_FILEVERSION
#define LIBRENT_FILEVERSION VER_PRODUCTVERSION
#endif /* LIBRENT_FILEVERSION */

#ifndef LIBRENT_PRODUCTVERSION
#define LIBRENT_PRODUCTVERSION VER_PRODUCTVERSION
#endif /* LIBRENT_PRODUCTVERSION */

#ifndef LIBRENT_FILEFLAGSMASK
#define LIBRENT_FILEFLAGSMASK 0x3fL
#endif /* LIBRENT_FILEFLAGSMASK */

#ifndef LIBRENT_FILEFLAGS
#ifdef _DEBUG
#define LIBRENT_FILEFLAGS VS_FF_DEBUG
#else
#define LIBRENT_FILEFLAGS 0x0L
#endif /* _DEBUG */
#endif /* LIBRENT_FILEFLAGS */

#ifndef LIBRENT_FILEOS
#define LIBRENT_FILEOS VOS_NT_WINDOWS32
#endif /* LIBRENT_FILEOS */

#ifndef LIBRENT_FILETYPE
#ifdef LIBRENT_VERSION_DLL
#define LIBRENT_FILETYPE VFT_DLL
#else
#define LIBRENT_FILETYPE VFT_APP
#endif /* LIBRENT_VERSION_DLL */
#endif /* LIBRENT_FILETYPE */

#ifndef LIBRENT_FILESUBTYPE
#define LIBRENT_FILESUBTYPE VFT2_UNKNOWN
#endif /* LIBRENT_FILESUBTYPE */

#ifndef LIBRENT_STR_COMPANY_NAME
#define LIBRENT_STR_COMPANY_NAME LIBRENT_DEFAULT_STR_COMPANY_NAME
#endif /* LIBRENT_STR_COMPANY_NAME */

#ifndef LIBRENT_STR_FILE_DESCRIPTION
#define LIBRENT_STR_FILE_DESCRIPTION LIBRENT_DEFAULT_STR_FILE_DESCRIPTION
#endif /* LIBRENT_STR_FILE_DESCRIPTION */

#ifndef LIBRENT_STR_FILE_VERSION
#define LIBRENT_STR_FILE_VERSION VER_PRODUCTVERSION_STR " (" KERNEL_VERSION_STR " " KERNEL_VERSION_BUILD_STR ")\0"
#endif /* LIBRENT_STR_FILE_VERSION */

#ifndef LIBRENT_STR_INTERNAL_NAME
#define LIBRENT_STR_INTERNAL_NAME LIBRENT_DEFAULT_STR_INTERNAL_NAME
#endif /* LIBRENT_STR_INTERNAL_NAME */

#ifndef LIBRENT_STR_LEGAL_COPYRIGHT
#define LIBRENT_STR_LEGAL_COPYRIGHT LIBRENT_DEFAULT_STR_LEGAL_COPYRIGHT
#endif /* LIBRENT_STR_LEGAL_COPYRIGHT */

#ifndef LIBRENT_STR_ORIGINAL_FILENAME
#define LIBRENT_STR_ORIGINAL_FILENAME ""
#endif /* LIBRENT_STR_ORIGINAL_FILENAME */

#ifndef LIBRENT_STR_PRODUCT_NAME
#define LIBRENT_STR_PRODUCT_NAME LIBRENT_DEFAULT_STR_PRODUCT_NAME
#endif /* LIBRENT_STR_PRODUCT_NAME */

#ifndef LIBRENT_STR_PRODUCT_VERSION
#define LIBRENT_STR_PRODUCT_VERSION VER_PRODUCTVERSION_STR "\0"
#endif /* LIBRENT_STR_PRODUCT_VERSION */

#ifndef LIBRENT_STR_PRODUCT_BUILD
#define LIBRENT_STR_PRODUCT_BUILD KERNEL_VERSION_BUILD_RC
#endif /* LIBRENT_STR_PRODUCT_BUILD */

/* The version resource itself */
VS_VERSION_INFO VERSIONINFO
FILEVERSION     LIBRENT_FILEVERSION
PRODUCTVERSION  LIBRENT_PRODUCTVERSION
FILEFLAGSMASK   LIBRENT_FILEFLAGSMASK
FILEFLAGS       LIBRENT_FILEFLAGS
FILEOS          LIBRENT_FILEOS
FILETYPE        LIBRENT_FILETYPE
FILESUBTYPE     LIBRENT_FILESUBTYPE
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",        LIBRENT_STR_COMPANY_NAME
            VALUE "FileDescription",    LIBRENT_STR_FILE_DESCRIPTION
            VALUE "FileVersion",        LIBRENT_STR_FILE_VERSION
            VALUE "InternalName",       LIBRENT_STR_INTERNAL_NAME
#ifdef LIBRENT_STR_ORIGINAL_COPYRIGHT
            VALUE "OriginalCopyright",  LIBRENT_STR_ORIGINAL_COPYRIGHT
#endif /* LIBRENT_STR_ORIGINAL_COPYRIGHT */
            VALUE "LegalCopyright",     LIBRENT_STR_LEGAL_COPYRIGHT
            VALUE "OriginalFilename",   LIBRENT_STR_ORIGINAL_FILENAME
            VALUE "ProductName",        LIBRENT_STR_PRODUCT_NAME
            VALUE "ProductVersion",     LIBRENT_STR_PRODUCT_VERSION
#ifdef LIBRENT_OLESELFREGISTER
            VALUE "OLESelfRegister",    ""
#endif /* LIBRENT_OLESELFREGISTER */
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
